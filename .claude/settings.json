{
  "permissions": {
    "allow": [
      "Bash(./scripts/check.sh)",
      "Bash(./scripts/check.sh --fast)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "WebFetch(domain:pakistan.diplo.de)",
      "WebFetch(domain:digital.diplo.de)",
      "WebFetch(domain:www.auswaertiges-amt.de)",
      "WebFetch(domain:www.make-it-in-germany.com)",
      "WebFetch(domain:ambislamabad.esteri.it)",
      "WebFetch(domain:conskarachi.esteri.it)",
      "WebFetch(domain:vistoinitalia.esteri.it)",
      "WebFetch(domain:france-visas.gouv.fr)",
      "WebFetch(domain:pk.ambafrance.org)",
      "WebFetch(domain:visa.vfsglobal.com)",
      "WebFetch(domain:www.vfsglobal.com)",
      "WebFetch(domain:home-affairs.ec.europa.eu)",
      "WebFetch(domain:eur-lex.europa.eu)",
      "WebFetch(domain:www.sbp.org.pk)",
      "WebFetch(domain:www.fbr.gov.pk)",
      "WebFetch(domain:beoe.gov.pk)",
      "WebFetch(domain:www.mofa.gov.pk)",
      "WebFetch(domain:www.secp.gov.pk)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm install:*)",
      "Bash(pnpm add:*)",
      "Bash(yarn add:*)",
      "Bash(bun add:*)",
      "Bash(pip install:*)",
      "Bash(uv add:*)",
      "Bash(cargo add:*)",
      "Bash(go get:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/after-edit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/before-stop.sh"
          }
        ]
      }
    ]
  }
}
